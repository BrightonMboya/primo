{
  "name": "primo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node serve.mjs",
    "seed": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "better-auth": "^1.7.20",
    "drizzle-orm": "^0.45.4",
    "html5-qrcode": "^2.3.8",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "nitro": "^3.0.261103-rc",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@tanstack/query-core": "5.105.0"
  }
}
