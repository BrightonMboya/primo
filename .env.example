# Copy to .env and fill in. On Vercel, add these in Project → Settings → Environment Variables.

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public address of the app, e.g. https://primo.vercel.app
BETTER_AUTH_URL=http://localhost:3210
# Extra addresses allowed to sign in from (comma separated), e.g. a tunnel URL
TRUSTED_ORIGINS=

# --- Database (Supabase Postgres) ---
# Leave empty to use the built-in local database in ./data (development only).
# Supabase → Project Settings → Database → Connection string:
#   app (Vercel):  "Transaction pooler", port 6543
DATABASE_URL=
#   migrations:    "Direct connection" or "Session pooler", port 5432
DATABASE_URL_DIRECT=

# --- Photos (Supabase Storage) ---
# Leave empty to keep photos in ./data/uploads (development only).
# Supabase -> Project Settings -> API: Project URL and the service_role key (keep it secret).
# The public bucket is created automatically on the first photo upload.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=primo-photos
